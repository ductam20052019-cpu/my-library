rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Create roles/{authUid} with { role: "admin" } for admin accounts.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == "admin";
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == "admin"
          || get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == "librarian"
        );
    }

    function isSeedAdmin() {
      return signedIn()
        && request.auth.uid == "2rEc9TY961QMmj9VF3e6JdP428y2"
        && request.auth.token.email == "lb@ptithcm.edu.vn";
    }

    function isSelfAuthUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSelfProfile() {
      return signedIn() && resource.data.authUid == request.auth.uid;
    }

    function isSelfUsernameIndex(username) {
      return signedIn()
        && exists(/databases/$(database)/documents/usernames/$(username))
        && get(/databases/$(database)/documents/usernames/$(username)).data.authUid == request.auth.uid;
    }

    function currentUsername() {
      return exists(/databases/$(database)/documents/authUsers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/authUsers/$(request.auth.uid)).data.userId
        : "";
    }

    function isOwnLoan(data) {
      return signedIn()
        && (
          data.userAuthUid == request.auth.uid
          || (data.username is string && data.username == currentUsername())
        );
    }

    function isOwnReservation(data) {
      return signedIn()
        && (
          data.userAuthUid == request.auth.uid
          || (data.username is string && data.username == currentUsername())
        );
    }

    function isOwnNotification(data) {
      return signedIn()
        && (
          data.targetAuthUid == request.auth.uid
          || (data.targetUsername is string && data.targetUsername == currentUsername())
          || (data.targetRole == "staff" && isStaff())
        );
    }

    function isOwnFavorite(data) {
      return signedIn()
        && (
          data.userAuthUid == request.auth.uid
          || (data.username is string && data.username == currentUsername())
        );
    }

    match /roles/{uid} {
      allow get: if isSelfAuthUid(uid) || isAdmin();
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
        || (isSeedAdmin()
          && isSelfAuthUid(uid)
          && request.resource.data.role == "admin");
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin()
        || (isSeedAdmin()
          && username == "ADMIN"
          && request.resource.data.userId == "admin"
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.role == "admin")
        || (signedIn()
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.userId == username);
      allow delete: if isAdmin();
    }

    match /authUsers/{uid} {
      allow get: if isSelfAuthUid(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        || (isSelfAuthUid(uid) && request.resource.data.userId is string);
      allow delete: if isAdmin();
    }

    match /users/{username} {
      allow get: if isStaff()
        || (isSeedAdmin() && username == "admin")
        || isSelfProfile()
        || isSelfUsernameIndex(username);
      allow list: if isStaff();
      allow create: if isAdmin()
        || (isSeedAdmin()
          && username == "admin"
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.role == "admin");
      allow update: if isAdmin()
        || (isSeedAdmin()
          && username == "admin"
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.role == "admin")
        || ((isSelfProfile() || isSelfUsernameIndex(username))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "pass",
            "password",
            "passwordHash",
            "authUid",
            "authProvider",
            "passwordManagedBy",
            "lastLoginAt",
            "passwordUpdatedAt",
            "mustChangePassword",
            "passwordMigrationRequiredAt"
          ]));
      allow delete: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /loans/{loanId} {
      allow get, list: if isStaff() || isOwnLoan(resource.data);
      allow create: if isStaff() || isOwnLoan(request.resource.data);
      allow update, delete: if isStaff();
    }

    match /reservations/{reservationId} {
      allow get, list: if isStaff() || isOwnReservation(resource.data);
      allow create: if isOwnReservation(request.resource.data)
        && request.resource.data.status == "waiting";
      allow update: if isStaff()
        || (isOwnReservation(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "cancelledAt", "cancelledBy"
          ])
          && request.resource.data.status == "cancelled");
      allow delete: if isStaff();
    }

    match /notifications/{notificationId} {
      allow get, list: if isStaff() || isOwnNotification(resource.data);
      allow create: if isStaff()
        || isOwnNotification(request.resource.data)
        || (signedIn() && request.resource.data.targetRole == "staff");
      allow update: if isStaff()
        || (isOwnNotification(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "read", "readAt"
          ]));
      allow delete: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow get, list: if isOwnFavorite(resource.data);
      allow create: if isOwnFavorite(request.resource.data);
      allow update: if isOwnFavorite(resource.data) && isOwnFavorite(request.resource.data);
      allow delete: if isOwnFavorite(resource.data);
    }

    match /activityLogs/{logId} {
      allow get, list, delete: if isAdmin();
      allow create: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
